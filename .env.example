# Browser client
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Optional compatibility during migration away from legacy anon
# VITE_SUPABASE_ANON_KEY=

# Server-side only
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-key
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres

# Test-only values, never commit real credentials
BARBEROS_TEST_EMAIL=
BARBEROS_TEST_PASSWORD=
BARBEROS_TEST_DATABASE_URL=
BARBEROS_TEST_ALLOW_MUTATION=0

# Public application URL used by notification links
BARBEROS_PUBLIC_URL=https://your-app.example

# Notification providers (server-side only)
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=BarberOS <no-reply@your-domain.example>
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v26.0
# JSON object mapping template_key to approved WhatsApp template metadata
# Example: {"appointment_confirmed":{"name":"appointment_confirmed","language":"pt_PT","body_params":["customer_name","shop_name","service_name","date","time","manage_url"]}}
WHATSAPP_TEMPLATES_JSON={}
