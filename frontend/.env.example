VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Root domain used for canonical shop subdomains, e.g. loja.barberos.com.
# Keep empty on localhost/preview deployments to use /barbearia/{slug} links.
VITE_BARBEROS_ROOT_DOMAIN=

# Enable only after the Phase 8 incident migration has been applied and verified in this environment.
VITE_SHOP_OPERATIONS_INCIDENTS_ENABLED=false
